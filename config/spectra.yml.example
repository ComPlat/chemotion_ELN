development:
  :chemspectra:
    :url: 'http://0.0.0.0:3007'
  :nmriumwrapper:
    # Self-hosted: the nmrium-assets service in docker-compose.dev.yml copies the
    # pinned wrapper build into public/nmrium/, which Rails serves from the app's
    # own origin. The trailing slash is required — the build references its
    # chunks relatively, so without it every ./assets/... request 404s.
    :url: '/nmrium/default/'
    # Public instance instead (no local assets, no compose service needed):
    # :url: 'https://nmrium.nmrxiv.org'

test:
  :chemspectra:
    :url: 'http://123.123.123.123:2412'
  :nmriumwrapper:
    :url: 'https://nmrium.nmrxiv.org'

production:
  :chemspectra:
    :url: 'http://0.0.0.0:3007'
  :nmriumwrapper:
    :url: 'https://nmrium.nmrxiv.org'
