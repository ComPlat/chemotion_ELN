# ChemSpectra and NMRium. Rails merges `shared:` into every environment; an
# environment block only needs the keys it changes.
shared:
  :chemspectra:
    # The spectra container of docker-compose.services.yml (development) and of
    # the production images, both reached on the `chemotion` network.
    :url: 'http://spectra:4000/'
  :nmriumwrapper:
    # Self-hosted: the nmrium-assets service in docker-compose.services.yml (and
    # the production eln image) put the pinned wrapper build into public/nmrium/,
    # which Rails serves from the app's own origin. The trailing slash is
    # required — the build references its chunks relatively, so without it every
    # ./assets/... request 404s.
    :url: '/nmrium/default/'
    # Public instance instead (no local assets needed):
    # :url: 'https://nmrium.nmrxiv.org'
